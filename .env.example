# MCP Shared Memory Server - Environment Configuration
# Copy this to .env and fill in your values:  cp .env.example .env

# MongoDB (required)
MONGO_HOST=localhost
# Host-side debug port only (server talks to Mongo over the compose network on
# 27017). Must match docker-compose.yml, which publishes 27019.
MONGO_PORT=27019
MONGO_DB=mcp_orchestrator
MONGO_USER=mcp_orch
MONGO_PASSWORD=changeme

# ChromaDB (required)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Authentication (optional - disabled by default for local use) ──────────
# MCP_AUTH_ENABLED=true validates keys: a valid key is scoped to its role and
# projects, and a present-but-INVALID key is always rejected. A session with NO
# key still soft-falls to the agent tier (all projects) unless one of the two
# REQUIRE flags below fires. Create keys with memory_admin after enabling.
# MCP_AUTH_ENABLED=true
#
# Reject EVERY keyless session (default false). Use this for any server
# reachable beyond a trusted LAN where every client holds a key (e.g. a
# Tailscale-only team box). With it on, memory_report_context is self-report
# only for non-owner/admin callers.
# JUNTO_REQUIRE_KEY=false
#
# Reject keyless sessions that arrive via the Cloudflare tunnel, detected by the
# CF-Connecting-IP header (code default true). docker-compose.yml overrides it
# to false because Cloudflare Access authenticates at the edge.
# JUNTO_TUNNEL_REQUIRES_KEY=true

# Connection-secret vault for local-model delegation (optional).
# Needed only if agents' connections carry secrets (imap password, mcp token, ...).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this file out of git and backups; losing the key means re-entering the secrets.
# JUNTO_VAULT_KEY=
# Runner host(s) a newly requested connection may run on (comma list, matching the
# runners' host names). Unset = none: assign hosts in /admin before activating.
# JUNTO_DEFAULT_RUNNER_HOSTS=gpu-1

# Anthropic API key (required only for librarian enrichment service)
# ANTHROPIC_API_KEY=sk-ant-...

# Librarian project roots - JSON map of project name to filesystem path
# Used by the librarian to resolve file paths for code analysis
# LIBRARIAN_PROJECT_ROOTS={"myproject":"/home/user/myproject"}

# External Databases (optional) - use DB_<NAME>_* pattern
# Each database needs at minimum: DB_<NAME>_TYPE and DB_<NAME>_HOST
# Supported types: mssql, mysql
# Default ports: mssql=1433, mysql=3306
#
# MSSQL example:
# DB_MYDB_TYPE=mssql
# DB_MYDB_HOST=myserver.database.windows.net
# DB_MYDB_PORT=1433
# DB_MYDB_NAME=mydb
# DB_MYDB_USER=myuser
# DB_MYDB_PASS=mypassword
# DB_MYDB_READONLY=true
# DB_MYDB_TIMEOUT=30
# DB_MYDB_MAX_ROWS=500
#
# MySQL example:
# DB_OTHERDB_TYPE=mysql
# DB_OTHERDB_HOST=mysql.example.com
# DB_OTHERDB_PORT=3306
# DB_OTHERDB_NAME=otherdb
# DB_OTHERDB_USER=readonly
# DB_OTHERDB_PASS=password
# DB_OTHERDB_READONLY=true

# ── Deployment identity / network (read by docker-compose.yml) ─────────────
# REQUIRED. LAN or Tailscale IP the MCP port 8080 binds to, in addition to
# 127.0.0.1. docker compose refuses to start until it is set (no default). For a
# localhost-only install, drop that port mapping in docker-compose.yml.
JUNTO_MCP_LAN_IP=192.0.2.10
# Unique id for this server instance (replication/sync provenance). Default: central.
# ORIGIN_SERVER_ID=central

# ── Sessions / SSE ─────────────────────────────────────────────────────────
# Expire a session with no tool call for N hours AND no live inbox SSE
# subscription (default 6; 0 disables). The 14-day TTL still applies to all.
# JUNTO_SESSION_IDLE_HOURS=6
# Persist sessions to Mongo so session_ids survive a server restart (default true).
# JUNTO_SESSION_PERSIST=true
# How often (seconds) live sessions are snapshotted for that (default 60).
# JUNTO_SESSION_SNAPSHOT_SECONDS=60
# Keepalive interval on the inbox SSE stream (default 20). Keep it shorter
# than the shortest idle timeout on the network path.
# JUNTO_SSE_KEEPALIVE_SECONDS=20
# Send timeout for one keepalive write; a stuck write prunes the dead socket (default 5).
# JUNTO_SSE_KEEPALIVE_TIMEOUT=5

# ── Messaging ──────────────────────────────────────────────────────────────
# Per-subscriber send timeout for inbox push notifications, so one half-open
# socket cannot stall delivery to everyone else (default 5 seconds).
# JUNTO_NOTIFY_SEND_TIMEOUT=5

# ── Identity lifecycle / retention ─────────────────────────────────────────
# Reap PENDING-tier roster ghosts idle past the grace window (default false).
# Named/admin agents, live sessions and open obligations are never reaped.
# Promote legitimate long-lived agents to named before enabling.
# JUNTO_PENDING_REAP_ENABLED=false
# JUNTO_PENDING_REAP_GRACE_HOURS=48
# Assistant-class identities (claude.ai chats registered as assistant<Project>-<topic>):
# after this many idle days their owned specs transfer to the project fallback
# owner (default 14) and their open action messages are re-homed (default 7).
# ASSISTANT_SPEC_ESCHEAT_IDLE_DAYS=14
# ASSISTANT_MSG_ESCHEAT_IDLE_DAYS=7
# Message and action-lapse retention are runtime settings, not env: see
# memory_admin push_control_set_config (action_lapse_days, default 30).

# ── Privacy ────────────────────────────────────────────────────────────────
# Store the TEXT of memory_query / recall queries in the metrics collections
# (query_events, recall_events; 90-day TTL). Default true. false keeps the
# ids/scores rows but stores query=None, for deployments where what people
# search for must not sit in the database. Read per call, so no restart is needed.
# JUNTO_LOG_QUERY_TEXT=true

# ── Optional local inference (all OFF by default; each fails open) ────────
# Cross-encoder reranker for memory_query (interface:rerank-v0). Service:
# contrib/reranker/rerank_server.py (GPU, bge-reranker-v2-m3). The ON switch is
# NOT an env var: it is query_config `rerank`, set with
#   memory_admin(action="query_set_config", key="rerank", value=true)        # all projects
#   memory_admin(action="query_set_config", project="p", key="rerank", value=true)
# Only turn it on once the service answers: with the flag on and no service,
# every memory_query waits up to the timeout before falling back.
# JUNTO_RERANK_URL=http://host.docker.internal:8091
# JUNTO_RERANK_TIMEOUT=2.0
#
# Write-time contradiction check on memory_record_learning (advisory, never
# blocks). Needs an OpenAI-compatible /v1 endpoint (e.g. Ollama).
# JUNTO_CLAIM_GATE_ENABLED=false
# JUNTO_CLAIM_GATE_URL=http://host.docker.internal:11434/v1
# The classify judge, and also the extractor unless EXTRACT_MODEL is set (default phi4:14b).
# JUNTO_CLAIM_GATE_MODEL=phi4:14b
# Optional separate model for claim extraction + facets (unset = CLAIM_GATE_MODEL).
# JUNTO_CLAIM_GATE_EXTRACT_MODEL=
# Optional reasoning_effort for the extract calls. Thinking models need "none",
# or they spend the whole token budget thinking and return nothing.
# JUNTO_CLAIM_GATE_EXTRACT_REASONING=
#
# Facets on learnings (claim / operation / trigger / shelf_life), extracted in
# the background after the write. Uses the claim-gate endpoint and extract model.
# Backfill older learnings with scripts/facets_backfill.py.
# JUNTO_FACETS_ENABLED=false
#
# Chunk side-index (experimental; its ON switch is query_config `chunk_index`,
# default off). Embeddings come from an Ollama endpoint.
# JUNTO_EMBED_URL=http://host.docker.internal:11434
# JUNTO_CHUNK_EMBED_TIMEOUT=1.5
# Background freshness sweep interval in seconds (default 900; 0 disables).
# Each pass is a no-op while no project has chunk_index on.
# JUNTO_CHUNK_SWEEP_SECONDS=900
# Chroma database name for chunk collections (default junto_chunks).
# JUNTO_CHUNK_DB=junto_chunks
# Chunker version stamp (default 2). Changing it rebuilds every chunk collection.
# JUNTO_CHUNKER=2

# ── Function registry → librarian ──────────────────────────────────────────
# Webhook the server pings when functions are registered (default below).
# Harmless if no librarian is running.
# LIBRARIAN_WEBHOOK_URL=http://localhost:8085/webhook

# ── Server-to-server sync (peer mode; read by the sync-engine daemon) ──────
# See docker-compose.peer.yml and docs/peer-deployment.md.
# JUNTO_SYNC_PRIMARY_URL=http://<primary>:8080/mcp
# JUNTO_SYNC_PRIMARY_KEY=smk_...
# JUNTO_SYNC_LOCAL_URL=http://localhost:8080/mcp
# JUNTO_SYNC_LOCAL_KEY=smk_...
# JUNTO_SYNC_CURSOR_PATH=~/.junto/sync-cursors.json
# JUNTO_SYNC_PULL_INTERVAL=10
# JUNTO_SYNC_PUSH_INTERVAL=5
# JUNTO_SYNC_PULL_JITTER=3
# JUNTO_SYNC_PUSH_JITTER=2
# JUNTO_SYNC_LIMIT=500
# JUNTO_SYNC_AGENT_NAME=sync-engine
# JUNTO_SYNC_PROJECT=junto
# LOG_LEVEL=INFO

# ── Diagnostics ────────────────────────────────────────────────────────────
# Per-call timing log lines (default off; zero overhead when unset). For diagnosis runs only.
# JUNTO_TIMING_LOG=

# ── Host-side tools (NOT read by the server; export in your shell or unit) ──
# No default: the tool exits with a clear message when unset.
# Ollama base URL (http/https only) for contrib/local-inference/li.py.
# JUNTO_OLLAMA_URL=http://<ollama-host>:11434
